{
  "version": 1,
  "name": "catppuccin-latte",
  "palette": {
    "rosewater": "#dc8a78",
    "flamingo": "#dd7878",
    "pink": "#ea76cb",
    "mauve": "#8839ef",
    "red": "#d20f39",
    "maroon": "#e64553",
    "peach": "#fe640b",
    "yellow": "#df8e1d",
    "green": "#40a02b",
    "teal": "#179299",
    "sky": "#04a5e5",
    "sapphire": "#209fb5",
    "blue": "#1e66f5",
    "lavender": "#7287fd",
    "text": "#4c4f69",
    "subtext1": "#5c5f77",
    "subtext0": "#6c6f85",
    "overlay2": "#7c7f93",
    "overlay1": "#8c8fa1",
    "overlay0": "#9ca0b0",
    "surface2": "#acb0be",
    "surface1": "#bcc0cc",
    "surface0": "#ccd0da",
    "base": "#eff1f5",
    "mantle": "#e6e9ef",
    "crust": "#dce0e8",
    "selectedBg": "#ccd0da",
    "scrollbarThumb": "#bcc0cc",
    "searchMatchBg": "#bcc0cc",
    "userMsgBg": "#ccd0da",
    "customMsgBg": "#ccd0da",
    "toolPendingBg": "#e6e9ef",
    "toolSuccessBg": "#ccd0da",
    "toolErrorBg": "#ccd0da",
    "infoBg": "#ccd0da"
  },
  "interface": {
    "text": "$text",
    "accent": "$mauve",
    "correct": "$green",
    "error": "$red",
    "muted": "$subtext0",
    "pending": "$overlay0",
    "selection_background": "$selectedBg"
  },
  "syntax": {
    "default": "$text",
    "comment": "$overlay1",
    "keyword": "$mauve",
    "function": "$blue",
    "variable": "$text",
    "string": "$green",
    "number": "$peach",
    "type": "$yellow",
    "operator": "$sky",
    "punctuation": "$overlay2"
  }
}
