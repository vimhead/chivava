{
  "version": 1,
  "name": "vantablack",
  "palette": {
    "accent": "#8d8d8d",
    "selection": "#1a1a1a",
    "muted": "#7a7a7a",
    "background": "#000000",
    "darkBackground": "#090909",
    "darkerBackground": "#070707",
    "lighterBackground": "#1a1a1a",
    "foreground": "#ffffff",
    "darkForeground": "#505050",
    "lightForeground": "#ececec",
    "brightForeground": "#ffffff",
    "red": "#a4a4a4",
    "yellow": "#cecece",
    "orange": "#b9b9b9",
    "green": "#b6b6b6",
    "cyan": "#b0b0b0",
    "blue": "#8d8d8d",
    "magenta": "#9b9b9b",
    "brown": "#5c5c5c",
    "brightRed": "#a4a4a4",
    "brightYellow": "#cecece",
    "brightGreen": "#b6b6b6",
    "brightCyan": "#b0b0b0",
    "brightBlue": "#8d8d8d",
    "brightMagenta": "#9b9b9b"
  },
  "interface": {
    "text": "$foreground",
    "accent": "$accent",
    "correct": "$green",
    "error": "$red",
    "muted": "$darkForeground",
    "pending": "$muted",
    "selection_background": "$selection"
  },
  "syntax": {
    "default": "$foreground",
    "comment": "$darkForeground",
    "keyword": "$magenta",
    "function": "$blue",
    "variable": "$foreground",
    "string": "$green",
    "number": "$orange",
    "type": "$yellow",
    "operator": "$cyan",
    "punctuation": "$lightForeground"
  }
}
