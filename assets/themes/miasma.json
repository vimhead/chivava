{
  "version": 1,
  "name": "miasma",
  "palette": {
    "bg": "#222222",
    "fg": "#c2c2b0",
    "gray": "#666666",
    "darkGray": "#313131",
    "accent": "#c9a554",
    "accentDark": "#977322",
    "accentMid": "#c5b382",
    "secondary": "#5f875f",
    "white": "#f5f5f5",
    "panel": "#272727",
    "panelAlt": "#2a2a2a",
    "panelSuccess": "#292929",
    "panelError": "#2f2b29",
    "panelInfo": "#2c2c2c",
    "success": "#5f875f",
    "error": "#bb7744",
    "warning": "#78824b",
    "diffAdded": "#9cab91",
    "diffRemoved": "#bfa282",
    "diffContext": "#b1b1a2"
  },
  "interface": {
    "text": "default",
    "accent": "$accent",
    "correct": "$success",
    "error": "$error",
    "muted": "$gray",
    "pending": "$gray",
    "selection_background": "$panelInfo"
  },
  "syntax": {
    "default": "default",
    "comment": "$gray",
    "keyword": "$accent",
    "function": "$secondary",
    "variable": "$fg",
    "string": "$success",
    "number": "$warning",
    "type": "$white",
    "operator": "$error",
    "punctuation": "$gray"
  }
}
