{
  "version": 1,
  "name": "catppuccin-macchiato",
  "palette": {
    "rosewater": "#f4dbd6",
    "flamingo": "#f0c6c6",
    "pink": "#f5bde6",
    "mauve": "#c6a0f6",
    "red": "#ed8796",
    "maroon": "#ee99a0",
    "peach": "#f5a97f",
    "yellow": "#eed49f",
    "green": "#a6da95",
    "teal": "#8bd5ca",
    "sky": "#91d7e3",
    "sapphire": "#7dc4e4",
    "blue": "#8aadf4",
    "lavender": "#b7bdf8",
    "text": "#cad3f5",
    "subtext1": "#b8c0e0",
    "subtext0": "#a5adcb",
    "overlay2": "#939ab7",
    "overlay1": "#8087a2",
    "overlay0": "#6e738d",
    "surface2": "#5b6078",
    "surface1": "#494d64",
    "surface0": "#363a4f",
    "base": "#24273a",
    "mantle": "#1e2030",
    "crust": "#181926",
    "selectedBg": "#363a4f",
    "scrollbarThumb": "#494d64",
    "searchMatchBg": "#494d64",
    "userMsgBg": "#363a4f",
    "customMsgBg": "#363a4f",
    "toolPendingBg": "#1e2030",
    "toolSuccessBg": "#363a4f",
    "toolErrorBg": "#363a4f",
    "infoBg": "#363a4f"
  },
  "interface": {
    "text": "$text",
    "accent": "$mauve",
    "correct": "$green",
    "error": "$red",
    "muted": "$subtext0",
    "pending": "$overlay0",
    "selection_background": "$selectedBg"
  },
  "syntax": {
    "default": "$text",
    "comment": "$overlay1",
    "keyword": "$mauve",
    "function": "$blue",
    "variable": "$text",
    "string": "$green",
    "number": "$peach",
    "type": "$yellow",
    "operator": "$sky",
    "punctuation": "$overlay2"
  }
}
