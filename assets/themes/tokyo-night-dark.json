{
  "version": 1,
  "name": "tokyo-night-dark",
  "palette": {
    "cyan": "#7dcfff",
    "blue": "#7aa2f7",
    "green": "#9ece6a",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "magenta": "#bb9af7",
    "orange": "#ff9e64",
    "teal": "#73daca",
    "text": "#c0caf5",
    "white": "#c0caf5",
    "gray": "#565f89",
    "dimGray": "#697096",
    "darkGray": "#292e42",
    "purpleMuted": "#3d3577",
    "bgDark": "#1a1b26",
    "bgDarker": "#16161e",
    "bgHighlight": "#292e42",
    "userMsgBg": "#1f2335",
    "toolPendingBg": "#24283b",
    "toolSuccessBg": "#28303b",
    "toolErrorBg": "#3b2528",
    "customMsgBg": "#26253c"
  },
  "interface": {
    "text": "$text",
    "accent": "$magenta",
    "correct": "$green",
    "error": "$red",
    "muted": "$gray",
    "pending": "$dimGray",
    "selection_background": "$bgHighlight"
  },
  "syntax": {
    "default": "$text",
    "comment": "#565f89",
    "keyword": "#bb9af7",
    "function": "#7aa2f7",
    "variable": "#c0caf5",
    "string": "#9ece6a",
    "number": "#ff9e64",
    "type": "#7dcfff",
    "operator": "#89ddff",
    "punctuation": "#89ddff"
  }
}
