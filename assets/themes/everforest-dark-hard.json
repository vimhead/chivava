{
  "version": 1,
  "name": "everforest-dark-hard",
  "palette": {
    "bg_dim": "#1E2326",
    "bg0": "#272E33",
    "bg1": "#2E383C",
    "bg2": "#374145",
    "bg3": "#414B50",
    "bg4": "#495156",
    "bg5": "#4F5B58",
    "bg_visual": "#4C3743",
    "bg_red": "#493B40",
    "bg_yellow": "#45443c",
    "bg_green": "#3C4841",
    "bg_blue": "#384B55",
    "bg_purple": "#463F48",
    "fg": "#D3C6AA",
    "red": "#E67E80",
    "orange": "#E69875",
    "yellow": "#DBBC7F",
    "green": "#A7C080",
    "aqua": "#83C092",
    "blue": "#7FBBB3",
    "purple": "#D699B6",
    "grey0": "#7A8478",
    "grey1": "#859289",
    "grey2": "#9DA9A0",
    "statusline1": "#A7C080",
    "statusline2": "#D3C6AA",
    "statusline3": "#E67E80"
  },
  "interface": {
    "text": "$fg",
    "accent": "$aqua",
    "correct": "$green",
    "error": "$red",
    "muted": "$grey1",
    "pending": "$grey0",
    "selection_background": "$bg_visual"
  },
  "syntax": {
    "default": "$fg",
    "comment": "$grey1",
    "keyword": "$red",
    "function": "$green",
    "variable": "$blue",
    "string": "$green",
    "number": "$purple",
    "type": "$yellow",
    "operator": "$orange",
    "punctuation": "$grey1"
  }
}
