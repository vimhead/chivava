{
  "version": 1,
  "name": "catppuccin-mocha",
  "palette": {
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "maroon": "#eba0ac",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "overlay2": "#9399b2",
    "overlay1": "#7f849c",
    "overlay0": "#6c7086",
    "surface2": "#585b70",
    "surface1": "#45475a",
    "surface0": "#313244",
    "base": "#1e1e2e",
    "mantle": "#181825",
    "crust": "#11111b",
    "selectedBg": "#313244",
    "scrollbarThumb": "#45475a",
    "searchMatchBg": "#45475a",
    "userMsgBg": "#313244",
    "customMsgBg": "#313244",
    "toolPendingBg": "#181825",
    "toolSuccessBg": "#313244",
    "toolErrorBg": "#313244",
    "infoBg": "#313244"
  },
  "interface": {
    "text": "$text",
    "accent": "$mauve",
    "correct": "$green",
    "error": "$red",
    "muted": "$subtext0",
    "pending": "$overlay0",
    "selection_background": "$selectedBg"
  },
  "syntax": {
    "default": "$text",
    "comment": "$overlay1",
    "keyword": "$mauve",
    "function": "$blue",
    "variable": "$text",
    "string": "$green",
    "number": "$peach",
    "type": "$yellow",
    "operator": "$sky",
    "punctuation": "$overlay2"
  }
}
