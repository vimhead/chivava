{
  "version": 1,
  "name": "everforest-dark-medium",
  "palette": {
    "bg_dim": "#232A2E",
    "bg0": "#2D353B",
    "bg1": "#343F44",
    "bg2": "#3D484D",
    "bg3": "#475258",
    "bg4": "#4F585E",
    "bg5": "#56635f",
    "bg_visual": "#543A48",
    "bg_red": "#514045",
    "bg_yellow": "#4D4C43",
    "bg_green": "#425047",
    "bg_blue": "#3A515D",
    "bg_purple": "#4A444E",
    "fg": "#D3C6AA",
    "red": "#E67E80",
    "orange": "#E69875",
    "yellow": "#DBBC7F",
    "green": "#A7C080",
    "aqua": "#83C092",
    "blue": "#7FBBB3",
    "purple": "#D699B6",
    "grey0": "#7A8478",
    "grey1": "#859289",
    "grey2": "#9DA9A0",
    "statusline1": "#A7C080",
    "statusline2": "#D3C6AA",
    "statusline3": "#E67E80"
  },
  "interface": {
    "text": "$fg",
    "accent": "$aqua",
    "correct": "$green",
    "error": "$red",
    "muted": "$grey1",
    "pending": "$grey0",
    "selection_background": "$bg_visual"
  },
  "syntax": {
    "default": "$fg",
    "comment": "$grey1",
    "keyword": "$red",
    "function": "$green",
    "variable": "$blue",
    "string": "$green",
    "number": "$purple",
    "type": "$yellow",
    "operator": "$orange",
    "punctuation": "$grey1"
  }
}
