{
  "version": 1,
  "name": "matte-black",
  "palette": {
    "bg": "#121212",
    "fg": "#bebebe",
    "gray": "#8a8a8c",
    "darkGray": "#212121",
    "accent": "#ffc107",
    "accentDark": "#cd8f00",
    "accentMid": "#debf62",
    "secondary": "#89b5c7",
    "white": "#ffffff",
    "panel": "#171717",
    "panelAlt": "#1a1a1a",
    "panelSuccess": "#1a1b1a",
    "panelError": "#211b1b",
    "panelInfo": "#1c1c1c",
    "success": "#89b589",
    "error": "#d35e5e",
    "warning": "#cbb589",
    "diffAdded": "#a9baa9",
    "diffRemoved": "#c69595",
    "diffContext": "#b4b4b5"
  },
  "interface": {
    "text": "default",
    "accent": "$accent",
    "correct": "$success",
    "error": "$error",
    "muted": "$gray",
    "pending": "$gray",
    "selection_background": "$panelInfo"
  },
  "syntax": {
    "default": "default",
    "comment": "$gray",
    "keyword": "$accent",
    "function": "$secondary",
    "variable": "$fg",
    "string": "$success",
    "number": "$warning",
    "type": "$white",
    "operator": "$error",
    "punctuation": "$gray"
  }
}
