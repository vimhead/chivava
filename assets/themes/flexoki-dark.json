{
  "version": 1,
  "name": "flexoki-dark",
  "palette": {
    "paper": "#FFFCF0",
    "black": "#100F0F",
    "base-950": "#1C1B1A",
    "base-900": "#282726",
    "base-850": "#343331",
    "base-800": "#403E3C",
    "base-700": "#575653",
    "base-600": "#6F6E69",
    "base-500": "#878580",
    "base-400": "#9F9D96",
    "base-300": "#B7B5AC",
    "base-200": "#CECDC3",
    "red": "#AF3029",
    "red-400": "#D14D41",
    "orange": "#BC5215",
    "orange-400": "#DA702C",
    "yellow": "#AD8301",
    "yellow-400": "#D0A215",
    "green": "#66800B",
    "green-400": "#879A39",
    "cyan": "#24837B",
    "cyan-400": "#3AA99F",
    "blue": "#205EA6",
    "blue-400": "#4385BE",
    "purple": "#5E409D",
    "purple-400": "#8B7EC8",
    "magenta": "#A02F6F",
    "magenta-400": "#CE5D97",
    "green-900": "#252D09",
    "red-900": "#3E1715"
  },
  "interface": {
    "text": "$base-300",
    "accent": "$cyan-400",
    "correct": "$green-400",
    "error": "$red-400",
    "muted": "$base-400",
    "pending": "$base-500",
    "selection_background": "$base-850"
  },
  "syntax": {
    "default": "$base-300",
    "comment": "$base-500",
    "keyword": "$blue",
    "function": "$orange-400",
    "variable": "$cyan-400",
    "string": "$green",
    "number": "$purple-400",
    "type": "$magenta-400",
    "operator": "$base-400",
    "punctuation": "$base-400"
  }
}
