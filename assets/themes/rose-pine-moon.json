{
  "version": 1,
  "name": "rose-pine-moon",
  "palette": {
    "panel": "#2a273f",
    "element": "#393552",
    "text": "#e0def4",
    "muted": "#6e6a86",
    "accent": "#c4a7e7",
    "border": "#44415a",
    "borderAccent": "#9ccfd8",
    "success": "#9ccfd8",
    "error": "#eb6f92",
    "warning": "#f6c177",
    "purple": "#c4a7e7",
    "heading": "#ea9a97",
    "link": "#9ccfd8",
    "code": "#f6c177",
    "bullet": "#ea9a97",
    "keyword": "#3e8fb0",
    "function": "#ea9a97",
    "variable": "#e0def4",
    "string": "#f6c177",
    "number": "#eb6f92",
    "type": "#9ccfd8",
    "operator": "#908caa",
    "punctuation": "#e0def4",
    "successBg": "#252e32",
    "errorBg": "#35222c"
  },
  "interface": {
    "text": "$text",
    "accent": "$accent",
    "correct": "$success",
    "error": "$error",
    "muted": "$muted",
    "pending": "$muted",
    "selection_background": "$element"
  },
  "syntax": {
    "default": "$text",
    "comment": "$muted",
    "keyword": "$keyword",
    "function": "$function",
    "variable": "$variable",
    "string": "$string",
    "number": "$number",
    "type": "$type",
    "operator": "$operator",
    "punctuation": "$punctuation"
  }
}
