{
  "version": 1,
  "name": "white",
  "palette": {
    "accent": "#6e6e6e",
    "selection": "#c0c0c0",
    "muted": "#808080",
    "background": "#ffffff",
    "darkBackground": "#f5f5f5",
    "darkerBackground": "#e8e8e8",
    "lighterBackground": "#c0c0c0",
    "foreground": "#000000",
    "darkForeground": "#c0c0c0",
    "lightForeground": "#000000",
    "brightForeground": "#000000",
    "red": "#2a2a2a",
    "yellow": "#4a4a4a",
    "orange": "#4a4a4a",
    "green": "#3a3a3a",
    "cyan": "#3e3e3e",
    "blue": "#1a1a1a",
    "magenta": "#2e2e2e",
    "brown": "#808080",
    "brightRed": "#2a2a2a",
    "brightYellow": "#4a4a4a",
    "brightGreen": "#3a3a3a",
    "brightCyan": "#3e3e3e",
    "brightBlue": "#1a1a1a",
    "brightMagenta": "#2e2e2e"
  },
  "interface": {
    "text": "$foreground",
    "accent": "$accent",
    "correct": "$green",
    "error": "$red",
    "muted": "$darkForeground",
    "pending": "$muted",
    "selection_background": "$selection"
  },
  "syntax": {
    "default": "$foreground",
    "comment": "$darkForeground",
    "keyword": "$magenta",
    "function": "$blue",
    "variable": "$foreground",
    "string": "$green",
    "number": "$orange",
    "type": "$yellow",
    "operator": "$cyan",
    "punctuation": "$lightForeground"
  }
}
